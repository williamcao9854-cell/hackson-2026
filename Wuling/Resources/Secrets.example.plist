<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  图像生成 API 配置模板。
  使用方法：复制一份，命名为 Secrets.plist（放在同一个文件夹），填入真实的值。
  Secrets.plist 已加入 .gitignore，不会被提交到 GitHub。
  没有 Secrets.plist 时，App 会使用离线水彩剪影，流程照样可以完整演示。
-->
<plist version="1.0">
<dict>
	<key>IMAGE_API_BASE_URL</key>
	<string>https://YOUR_AMD_API_HOST</string>
	<key>IMAGE_API_PATH</key>
	<string>/v1/images/generations</string>
	<key>IMAGE_API_KEY</key>
	<string>YOUR_API_KEY</string>
	<key>IMAGE_API_MODEL</key>
	<string>YOUR_IMAGE_MODEL</string>
	<key>IMAGE_API_SIZE</key>
	<string>1024x1024</string>
	<key>IMAGE_API_RESPONSE_FORMAT</key>
	<string>b64_json</string>
</dict>
</plist>
