<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  图像生成 API 配置模板（AiHubMix · gpt-image-2.6-flare，OpenAI 兼容格式）。
  使用方法：复制一份，命名为 Secrets.plist（放在同一个文件夹），把 IMAGE_API_KEY 换成真实的 Key。
  Secrets.plist 已加入 .gitignore，不会被提交到 GitHub。
  没有 Secrets.plist 时，App 会使用离线水彩剪影，流程照样可以完整演示。

  IMAGE_API_QUALITY：low 约 5 秒、约 0.026 美元一张，手机上看已经足够；medium / high 更细、更慢、更贵。
  老的 dall-e 类接口如果需要 response_format，可以再加一项 IMAGE_API_RESPONSE_FORMAT = b64_json。
-->
<plist version="1.0">
<dict>
	<key>IMAGE_API_BASE_URL</key>
	<string>https://api.inferera.com</string>
	<key>IMAGE_API_PATH</key>
	<string>/v1/images/generations</string>
	<key>IMAGE_API_KEY</key>
	<string>YOUR_API_KEY</string>
	<key>IMAGE_API_MODEL</key>
	<string>gpt-image-2.6-flare</string>
	<key>IMAGE_API_SIZE</key>
	<string>1024x1024</string>
	<key>IMAGE_API_QUALITY</key>
	<string>low</string>
	<key>IMAGE_API_OUTPUT_FORMAT</key>
	<string>png</string>
</dict>
</plist>
