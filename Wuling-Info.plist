<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  其余 Info.plist 键由 Xcode 根据 INFOPLIST_KEY_* 自动生成并合并进来。
  这里只声明「传灵」用的 .wuling 文件类型，让隔空投送收到的物灵能直接用物灵 App 打开。
-->
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>物灵</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.hackson2026.wuling.spirit</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.hackson2026.wuling.spirit</string>
			<key>UTTypeDescription</key>
			<string>物灵</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wuling</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>物灵需要连接身边的另一台手机，把物灵面对面传给对方。不会访问其他设备上的任何内容。</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_wuling-relay._tcp</string>
		<string>_wuling-relay._udp</string>
	</array>
</dict>
</plist>
